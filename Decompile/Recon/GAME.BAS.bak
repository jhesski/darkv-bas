16760 SUB S16760
16770 SCREEN 1
16780 RANDOMIZE 0#
16790 KEY 16, CHR$(0) + CHR$(1)
16800 REM PASS2-RECON: ON KEY(16) handler disabled (QB45 disallows in SUB)
16810 KEY(16) ON
16820 PALETTE 3, 6
16830 PALETTE 1, 2
16840 PALETTE 2, 11
16850 KEY OFF
16860 KEY 16, CHR$(0) + CHR$(1)
16870 REM PASS2-RECON: ON KEY(16) handler disabled
16880 KEY(16) ON
16890 DIM R28(1000) AS INTEGER 'PASS2-RECON: AS INTEGER - GET/PUT sprite arrays must be 2-byte integers to match .pct data (saved from integer GET arrays)
